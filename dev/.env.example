DATABASE_URL=mongodb://127.0.0.1/payload-cloudflare-build-status-plugin
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Required for the Cloudflare build status badge.
CF_ACCOUNT_ID=your-cloudflare-account-id
CF_API_TOKEN=your-cloudflare-api-token

# Prefer CF_WORKER_TAG when you have it. Otherwise set CF_WORKER_NAME
# and the plugin will resolve the Worker tag through Cloudflare.
CF_WORKER_TAG=your-worker-tag
# CF_WORKER_NAME=your-worker-name

# Optional: makes the badge link to the live site.
PUBLIC_SITE_URL=https://example.com
